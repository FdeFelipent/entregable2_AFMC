<main class="container">
    <header class="page-header">
        <div class="institution"><span class="institution-mark" aria-hidden="true">✳</span> UNIVERSIDAD DE LA AMAZONIA</div>
        <p class="eyebrow">GUÍA DE ESTUDIANTE <span aria-hidden="true">·</span> MOTOR DE PLANTILLAS</p>
        <h1>Plantilla de <span>contacto</span></h1>
    </header>
    <section class="content-panel">
        <div class="section-heading">
            <div>
                <p class="section-label">EJEMPLO DE VISTA</p>
                <h2>Campos de contacto</h2>
            </div>
            <span class="condition-badge">{{dato}}</span>
        </div>
        <p class="section-description">Esta plantilla muestra campos sencillos para recopilar información.</p>
        <div class="contact-fields">
            <label for="data">Información</label>
            <input type="text" name="data" id="data" placeholder="Información para enviar">

            <label for="email">Correo electrónico</label>
            <input type="email" name="email" id="email" placeholder="nombre@correo.com">
        </div>
    </section>
    <footer class="page-footer">
        <span>Una práctica de clase, compartida por una estudiante.</span>
        <a class="page-link" href="/">Volver a la guía <span aria-hidden="true">→</span></a>
    </footer>
</main>